# Resumind AI Backend Environment Variables
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/resumind_ai?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=resumind_ai

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AI Provider Configuration (Groq)
# Obtain key at: https://console.groq.com/
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Allowed Origins (Comma-separated for multiple origins)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting & Safety Limits
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10
MAX_RESUME_TEXT_CHARS=40000
MAX_JOB_DESCRIPTION_CHARS=20000
